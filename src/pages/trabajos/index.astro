---
import Layout from "../../layouts/Layout.astro";
import { getPublishedWork } from "../../lib/content";

const work = await getPublishedWork();
---

<Layout
	titulo="Trabajos — MarkiDev"
	descripcion="Casos reales de automatizacion y digitalizacion de negocios: que se hizo, para quien y que cambio despues."
>
	<section class="py-24 mx-auto max-w-[1200px] px-6">
		<h1 class="text-section leading-section font-semibold">Trabajos</h1>
		<p class="text-lead text-ink-subtle mt-6 max-w-[65ch]">
			Que se hizo, para quien, y que cambio despues.
		</p>

		{
			work.length === 0 ? (
				<p class="text-body text-ink-soft mt-12">Todavia no hay casos publicados.</p>
			) : (
				<ul class="mt-12 gap-6 grid sm:grid-cols-2">
					{work.map((item) => (
						<li class="border-hairline bg-surface rounded-lg border p-6">
							<article>
								<p class="text-body-sm text-ink-soft uppercase">{item.data.client}</p>
								<h2 class="text-title mt-2 font-semibold">
									<a href={`/trabajos/${item.id}/`} class="hover:text-accent-text transition-colors">
										{item.data.title}
									</a>
								</h2>
								<p class="text-body text-ink-subtle mt-3">{item.data.description}</p>
								{/* El resultado es lo que decide al que compara casos: se separa de
								    la descripcion con peso, no solo con espacio. */}
								<p class="text-body mt-4 text-ink font-semibold">{item.data.result}</p>
							</article>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Layout>
