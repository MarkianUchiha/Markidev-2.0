---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getPublishedWork } from "../../lib/content";
import { caso, migas } from "../../lib/schema";

export async function getStaticPaths() {
	const work = await getPublishedWork();
	return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout
	titulo={`${item.data.title} — MarkiDev`}
	descripcion={item.data.description}
	schema={[
		caso(item),
		migas([
			{ nombre: "Inicio", url: "/" },
			{ nombre: "Trabajos", url: "/trabajos/" },
			{ nombre: item.data.title, url: `/trabajos/${item.id}/` },
		]),
	]}
>
	<article class="py-24 mx-auto max-w-[1200px] px-6">
		<header class="max-w-[65ch]">
			<p class="text-body-sm text-ink-soft uppercase">{item.data.client}</p>
			<h1 class="text-section leading-section mt-3 font-semibold">{item.data.title}</h1>
			<p class="text-lead text-ink-subtle mt-6">{item.data.description}</p>
		</header>

		{/* El resultado va arriba y destacado: es lo unico que el cliente busca
		    cuando compara casos. */}
		<div class="bg-surface-sunken rounded-lg mt-8 p-6">
			<p class="text-body-sm text-ink-soft uppercase">Resultado</p>
			<p class="text-title mt-2 font-semibold">{item.data.result}</p>
		</div>

		<dl class="gap-6 mt-8 flex flex-wrap">
			<div>
				<dt class="text-body-sm text-ink-soft uppercase">Año</dt>
				<dd class="text-body mt-1">{item.data.year}</dd>
			</div>
			<div>
				<dt class="text-body-sm text-ink-soft uppercase">Servicios</dt>
				<dd class="text-body mt-1">{item.data.services.join(", ")}</dd>
			</div>
			{
				item.data.url && (
					<div>
						<dt class="text-body-sm text-ink-soft uppercase">Sitio</dt>
						<dd class="text-body mt-1">
							<a
								href={item.data.url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-brand hover:text-brand-deep"
							>
								Ver en linea
							</a>
						</dd>
					</div>
				)
			}
		</dl>

		<div class="prose-markidev mt-12 max-w-[65ch]">
			<Content />
		</div>
	</article>
</Layout>
