---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout
	titulo="MarkiDev — Automatizacion y digitalizacion de negocios"
	descripcion="Sitio en construccion. Pronto: casos reales de automatizacion y digitalizacion para negocios en Mexico."
>
	{/* El main ya lo pone el layout: aqui solo va el contenido de la pagina. */}
	<section class="mx-auto flex max-w-[1200px] flex-col justify-center px-6 py-section">
		<p class="text-caption tracking-caption text-ink-muted-48 uppercase">{site.name}</p>
		<h1 class="text-hero-display leading-hero-display tracking-hero-display mt-lg max-w-3xl font-semibold">
			Sitio en construccion.
		</h1>
		{/* La medida va en ch, no en max-w-xl: los tokens de espaciado del sistema
		    ocupan los nombres xs..xxl, asi que max-w-xl resolveria a 32px. */}
		<p class="text-lead leading-lead text-ink-muted-80 mt-lg max-w-[65ch]">
			Estamos rehaciendo esta web desde cero. Mientras tanto, la forma mas rapida de contactarnos
			sigue siendo el correo.
		</p>
		<a
			href={`mailto:${site.email}`}
			class="text-body-strong text-primary hover:text-primary-focus mt-xl inline-block"
		>
			{site.email}
		</a>
	</section>
</Layout>
