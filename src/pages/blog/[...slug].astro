---
import Layout from "../../layouts/Layout.astro";
import { getPostHtml, formatDate } from "../../lib/content";
import { articulo, migas } from "../../lib/schema";

// Sin `getStaticPaths`: las rutas ya no se conocen al compilar porque los
// articulos viven en D1 y aparecen o desaparecen desde el panel.
export const prerender = false;

const { slug } = Astro.params;
const resultado = slug ? await getPostHtml(slug) : null;

// Un articulo despublicado tiene que comportarse como uno que nunca existio. Si
// respondiera 200 con la pagina vacia, seguiria indexado y enlazado.
//
// `rewrite` y no una Response suelta: asi quien se equivoca de direccion cae en
// la misma pagina de 404 que el resto del sitio, con su menu y sus salidas, en
// vez de en una linea de texto plano. La URL no cambia, que es lo que distingue
// esto de una redireccion.
if (!resultado) {
	return Astro.rewrite("/404");
}

const { entrada: post, html } = resultado;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=600",
);
---

<Layout
	titulo={`${post.data.title} — MarkiDev`}
	descripcion={post.data.description}
	schema={[
		articulo(post),
		migas([
			{ nombre: "Inicio", url: "/" },
			{ nombre: "Blog", url: "/blog/" },
			{ nombre: post.data.title, url: `/blog/${post.id}/` },
		]),
	]}
>
	{/* En los articulos manda la capa editorial: ancho de lectura, no de galeria. */}
	<article class="py-24 mx-auto max-w-[65ch] px-6">
		<header>
			<h1 class="text-section leading-section font-semibold">{post.data.title}</h1>
			<time datetime={post.data.pubDate.toISOString()} class="text-body-sm text-ink-soft mt-6 block">
				{formatDate(post.data.pubDate)}
				{
					post.data.updatedDate && (
						<span> · actualizado el {formatDate(post.data.updatedDate)}</span>
					)
				}
			</time>
		</header>

		{/* `set:html` con HTML que ya paso por rehype-sanitize al guardarse. Es el
		    unico lugar del sitio donde entra HTML que no escribio este repositorio. */}
		<div class="prose-markidev mt-12" set:html={html} />

		{
			post.data.tags.length > 0 && (
				<footer class="border-hairline mt-12 pt-6 gap-2 flex flex-wrap border-t">
					{post.data.tags.map((tag) => (
						<span class="text-body-sm text-ink-soft bg-surface-sunken rounded-pill px-3 py-1">
							{tag}
						</span>
					))}
				</footer>
			)
		}
	</article>
</Layout>
