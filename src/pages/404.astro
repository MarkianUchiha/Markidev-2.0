---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

// Bajo demanda, no estatica, y no por gusto: los articulos del blog llegan aqui
// con `Astro.rewrite("/404")` cuando el slug no existe, y no se puede reescribir
// hacia una pagina que se horneo en el build —el servidor no la tiene entre sus
// rutas y revienta con un 500—. Prerenderizarla obligaria a mantener dos
// paginas de 404 distintas, que es peor que despertar al Worker.
export const prerender = false;

// A donde mandar a quien se perdio. No es el menu entero: son las tres cosas
// que alguien puede estar buscando cuando teclea mal una direccion de este
// sitio, en el orden en que se buscan.
const salidas = [
	{
		href: "/trabajos/",
		titulo: "Trabajos",
		descripcion: "Los sistemas que ya operan en negocios reales.",
	},
	{
		href: "/blog/",
		titulo: "Blog",
		descripcion: "Las preguntas que me hacen antes de contratar, respondidas.",
	},
	{
		href: "/contacto/",
		titulo: "Contacto",
		descripcion: "Cuéntame qué se te complica y te respondo yo mismo.",
	},
];
---

<Layout
	titulo="Esta página no existe — MarkiDev"
	descripcion="La dirección que buscas no está en markidev.com. Desde aquí puedes ir a los trabajos, al blog o escribirme directamente."
>
	<section class="mx-auto max-w-[1180px] px-8 py-24">
		<div class="grid items-center gap-16 lg:grid-cols-2">
			<div>
				<h1
					class="font-display text-ink-strong text-section leading-section tracking-section mb-5 font-titular"
				>
					Esta página no existe
				</h1>

				<p class="text-lead leading-lead text-ink-muted mb-10 max-w-[520px]">
					La dirección que abriste no lleva a ningún lado. Puede que el enlace
					estuviera mal escrito, o que algo que vivía aquí se haya movido.
				</p>

				<ul class="border-hairline flex flex-col border-t">
					{
						salidas.map(({ href, titulo, descripcion }) => (
							<li class="border-hairline border-b">
								<a
									href={href}
									class="group hover:bg-surface-sunken -mx-4 flex flex-col gap-1 rounded-md px-4 py-5 transition-colors"
								>
									<span class="font-display text-ink-strong text-title group-hover:text-brand font-titular transition-colors">
										{titulo}
									</span>
									<span class="text-body-sm text-ink-soft">{descripcion}</span>
								</a>
							</li>
						))
					}
				</ul>

				<p class="text-body-sm text-ink-soft mt-8">
					Si llegaste desde un enlace mío que ya no sirve,{" "}
					<a
						href={site.whatsapp.url}
						target="_blank"
						rel="noopener noreferrer"
						class="text-brand font-semibold underline underline-offset-4"
					>
						avísame por WhatsApp
					</a>{" "}
					y lo arreglo.
				</p>
			</div>

			{/* El numero va aqui y no de antetitulo a la izquierda: dos «404» en la
			    misma pantalla, uno diminuto y otro enorme, se leen como un descuido.
			    Este es el texto de verdad, no una decoracion con `aria-hidden`, asi
			    que quien navega con lector de pantalla tambien oye el codigo.

			    La imagen entra entera, en el 16:9 en que llego. Recortarla al 4:3 que
			    habia previsto dejaria fuera a los personajes de las orillas, que es
			    justo donde esta la gracia. */}
			<div class="border-hairline relative overflow-hidden rounded-lg border">
				{/* Las imagenes de `src/assets/` las procesa Astro, pero solo en las
				    paginas que se prerenderizan. Esta se sirve bajo demanda, asi que
				    ahi la tuberia emite URLs a `/_image`, y con `imageService:
				    "compile"` ese endpoint no transforma nada: devuelve el original
				    entero, con un srcset que promete un avif y entrega un jpeg de
				    188 KB. Por eso sale de `public/` ya convertida —una vez, no en cada
				    visita— y con las medidas escritas, para que la pagina no salte
				    mientras carga. */}
				<picture>
					<source srcset="/imagenes/404-discusion-civica.avif" type="image/avif" />
					<img
						src="/imagenes/404-discusion-civica.webp"
						alt="Un grupo de personajes de dibujos animados discute en plena calle bajo un letrero de «discusión cívica», con las líneas de sus conversaciones completamente enredadas sobre sus cabezas"
						width="1200"
						height="670"
						decoding="async"
						class="block w-full"
					/>
				</picture>

				{/* El velo no es un efecto: la imagen es clara y con mucho detalle en el
				    centro, y sin el, el numero se pierde entre las nubes de dialogo.

				    Y el color es `on-warm`, no `ink-strong`, porque este numero vive
				    sobre la imagen, que es clara en los dos modos: necesita un negro que
				    NO se invierta con el tema. `ink-strong` se volveria blanco en oscuro
				    y desapareceria. */}
				<p
					class="font-display text-on-warm absolute inset-0 flex items-center justify-center bg-white/45 text-[clamp(96px,14vw,180px)] leading-none font-titular tracking-[-0.04em]"
				>
					404
				</p>
			</div>
		</div>
	</section>
</Layout>
