---
import Panel from "../../../layouts/Panel.astro";
import Mensaje from "../../../components/panel/Mensaje.astro";
import { listarPosts } from "../../../lib/db";
import { formatDate } from "../../../lib/content";

export const prerender = false;

const usuario = Astro.locals.usuario;
if (!usuario) return new Response("No autorizado.", { status: 401 });

// Aqui si entran los borradores: el panel es donde se decide que se publica.
const posts = await listarPosts("blog", { soloPublicados: false });

const error = Astro.url.searchParams.get("error");
const aviso = Astro.url.searchParams.get("aviso");
const rotulo = Astro.url.searchParams.get("rotulo") ?? undefined;

const campo =
	"border-border bg-surface text-ink text-body-sm focus:border-ink-soft w-full rounded-md border px-3 py-2 focus:outline-none";
const boton =
	"text-body-sm border-border text-ink hover:bg-surface-sunken rounded-md border px-3 py-1.5 font-semibold transition-colors";
---

<Panel titulo="Contenido" usuario={usuario.email}>
	<div class="mb-8">
		<h1 class="font-display text-ink-strong text-section leading-section font-titular">
			Contenido
		</h1>
		<p class="text-body-sm text-ink-soft mt-1">
			{/* El `{" "}` no es decoracion: Astro se come el espacio entre una
			    expresion y el texto cuando hay un salto de linea en medio, y sale
			    «1artículo». */}
			{posts.length}{" "}
			{posts.length === 1 ? "artículo" : "artículos"} en el blog. Lo que se publica
			aquí se ve en el sitio en menos de un minuto.
		</p>
	</div>

	{/* El rotulo llega en la URL porque aqui caen errores de subir, publicar,
	    borrar y de la vista previa, y solo el endpoint sabe cual fue. */}
	{error && <Mensaje tipo="error" etiqueta={rotulo}>{error}</Mensaje>}

	{aviso && <Mensaje tipo="exito">{aviso}</Mensaje>}

	<form
		method="POST"
		action="/api/panel/contenido/"
		enctype="multipart/form-data"
		class="border-hairline bg-surface mb-10 rounded-lg border p-6"
	>
		<h2 class="font-display text-title text-ink-strong font-titular">Subir un artículo</h2>
		<p class="text-body-sm text-ink-muted mt-2 mb-6 max-w-[60ch]">
			Un archivo <code>.md</code> con su frontmatter entre líneas de
			<code>---</code>. El nombre del archivo es la dirección del artículo:
			<code>como-cobrar-un-anticipo.md</code> se publica en
			<code>/blog/como-cobrar-un-anticipo/</code>. Si ya existe uno con ese
			nombre, se reemplaza y la versión anterior se guarda.
		</p>

		<div class="flex max-w-[720px] flex-wrap items-end gap-4">
			<div class="min-w-[260px] flex-1">
				<label for="archivo" class="text-body-sm text-ink-strong mb-1.5 block font-semibold">
					Archivo
				</label>
				<input id="archivo" class={campo} type="file" name="archivo" accept=".md,text/markdown" required />
			</div>

			<button
				type="submit"
				class="bg-action text-on-action hover:bg-action-hover text-body-sm rounded-md px-5 py-2.5 font-semibold transition-colors"
			>
				Subir
			</button>
		</div>
	</form>

	{
		posts.length === 0 ? (
			<p class="text-body text-ink-soft">
				Todavía no hay artículos. Sube el primero con el formulario de arriba.
			</p>
		) : (
			<ul class="flex flex-col gap-4">
				{posts.map((post) => (
					<li class="border-hairline bg-surface rounded-lg border p-5">
						<div class="flex flex-wrap items-start justify-between gap-4">
							<div class="min-w-[240px] flex-1">
								<h2 class="font-display text-title text-ink-strong font-titular">{post.datos.title}</h2>
								<p class="text-body-sm text-ink-soft mt-1">
									{/* El estado no se deja solo al color: un chip verde y otro gris
									    se distinguen mal y no dicen nada a quien no ve color. */}
									{post.publicado ? "Publicado" : "Oculto"} ·{" "}
									{formatDate(post.datos.pubDate)} · <code>/blog/{post.id}/</code>
								</p>
							</div>

							<div class="flex flex-wrap items-center gap-2">
								{/* Primero ver y luego publicar: es el orden en que se usan, y deja
								    la revision a un clic de distancia en vez de obligar a publicar
								    para mirar. */}
								<a class={boton} href={`/panel/contenido/${post.id}/`}>
									Ver
								</a>

								<a class={boton} href={`/api/panel/contenido/${post.id}/`} download>
									Bajar .md
								</a>

								<form method="POST" action={`/api/panel/contenido/${post.id}/`}>
									<input type="hidden" name="accion" value="publicado" />
									<button type="submit" class={boton}>
										{post.publicado ? "Ocultar" : "Publicar"}
									</button>
								</form>
							</div>
						</div>

						{/* Borrar va detras de un pliegue en vez de un dialogo de confirmacion:
						    el panel no carga JavaScript y un `confirm()` lo obligaria. */}
						<details class="mt-4">
							<summary class="text-body-sm text-ink-soft cursor-pointer">Borrar</summary>
							<div class="mt-3 flex flex-wrap items-center gap-3">
								<p class="text-body-sm text-ink-muted">
									Se borra el artículo y todas sus revisiones. No se puede deshacer:
									baja el <code>.md</code> antes si quieres conservarlo.
								</p>
								<form method="POST" action={`/api/panel/contenido/${post.id}/`}>
									<input type="hidden" name="accion" value="borrar" />
									<button type="submit" class={boton}>Borrar definitivamente</button>
								</form>
							</div>
						</details>
					</li>
				))}
			</ul>
		)
	}
</Panel>
