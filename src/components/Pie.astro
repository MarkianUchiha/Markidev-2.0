---
import { site, socialLinks } from "../data/site";
import { getVisibleNavigation } from "../lib/content";

const availableNavigation = await getVisibleNavigation();
const year = new Date().getFullYear();
---

{/* El mockup trae un pie de una sola linea. Los enlaces de seccion se suman solos
    cuando exista contenido; mientras tanto se ve exactamente como el diseno. */}
<footer class="border-hairline mt-auto border-t">
	<div
		class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-8 py-8"
	>
		<div class="flex flex-wrap items-center gap-6">
			<span class="font-display text-ink-strong text-[15px] font-bold">
				{site.name}
			</span>
			<a
				href={`mailto:${site.email}`}
				class="text-brand hover:text-brand-deep text-body-sm transition-colors"
			>
				{site.email}
			</a>

			{
				availableNavigation.length > 0 && (
					<nav aria-label="Pie de pagina">
						<ul class="flex flex-wrap gap-5">
							{availableNavigation.map((item) => (
								<li>
									<a
										href={item.href}
										class="text-body-sm text-ink-soft hover:text-ink transition-colors"
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>

		<div class="flex flex-wrap items-center gap-6">
			<nav aria-label="Redes sociales">
				<ul class="flex gap-5">
					{
						socialLinks.map((red) => (
							<li>
								<a
									href={red.url}
									target="_blank"
									rel="noopener noreferrer me"
									class="text-body-sm text-ink-soft hover:text-ink transition-colors"
								>
									{red.name}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			{/* El aviso va aparte de la navegacion: es una obligacion legal que debe
			    alcanzarse desde cualquier pagina, no una seccion que se visite. */}
			<span class="text-eyebrow text-ink-soft">
				<a href="/aviso-de-privacidad/" class="hover:text-ink transition-colors">
					Aviso de privacidad
				</a>
				<span class="mx-2">·</span>
				Durango, México · © {year} {site.author}
			</span>
		</div>
	</div>
</footer>
