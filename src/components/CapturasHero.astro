---
import { Picture } from "astro:assets";
import puntoDeVenta from "../assets/hero/punto-de-venta.png";
import pedidosWhatsapp from "../assets/hero/pedidos-whatsapp.png";
import sitioWeb from "../assets/hero/sitio-web.png";

// Las capturas del hero rotan solas porque MarkiDev vende varias cosas distintas
// y una sola imagen subrepresenta el trabajo. Se hace con `@keyframes` y no con
// JavaScript por la misma decision que sostiene el resto del sitio publico: aqui
// no entra React ni una libreria de carrusel por una animacion de opacidad.
//
// Falta la de sistemas de gestion: sale del panel de Suudai con datos ficticios.
// Rotan tres en vez de dejar un hueco rayado en produccion; al llegar se agrega
// aqui y el ciclo de abajo vuelve a cuatro tiempos.
//
// El punto de venta va primero porque es la que queda fija con movimiento
// reducido, y es la que mas vende.
const diapositivas = [
	{
		src: puntoDeVenta,
		alt: "Punto de venta de Suudai con el catálogo de botellas y el ticket de la venta",
	},
	{
		src: pedidosWhatsapp,
		alt: "Formulario de pedido de Suudai que envía el pedido por WhatsApp",
	},
	{
		src: sitioWeb,
		alt: "Sitio web de EnarmDuo, plataforma para preparar el ENARM",
	},
];
---

{/* Una sola raiz: el hero es una rejilla de dos columnas y dos raices meterian
    un tercer hijo que la descuadra. */}
<div>
	<div class="grid" aria-label="Capturas de los sistemas que construyo">
		{
			diapositivas.map(({ src, alt }, indice) => (
				<div class="diapositiva border-hairline col-start-1 row-start-1 aspect-[4/3] overflow-hidden rounded-xl border">
					{/* La primera es la imagen mas grande de la primera pantalla: se
					    pide antes que el resto para no retrasar el LCP. */}
					<Picture
						src={src}
						alt={alt}
						formats={["avif", "webp"]}
						fallbackFormat="jpg"
						layout="constrained"
						width={640}
						height={480}
						class="size-full object-cover"
						loading={indice === 0 ? "eager" : "lazy"}
						fetchpriority={indice === 0 ? "high" : "auto"}
					/>
				</div>
			))
		}
	</div>

	{/* Los puntos solo avisan que hay mas de una captura: quien mira dos segundos
	    no lo sabria de otro modo. No se pueden pulsar, asi que no son controles y
	    por eso no entran en el arbol de accesibilidad. */}
	<ul class="mt-4 flex justify-center gap-2" aria-hidden="true">
		{diapositivas.map(() => <li class="punto size-1.5 rounded-full" />)}
	</ul>
</div>

<style>
	/* Las diapositivas se apilan en la misma celda de la rejilla en vez de
	   con `position: absolute`, asi el contenedor conserva la altura de una sola
	   y no hay que fijarsela a mano. */

	/* Tres diapositivas de 4s dan un ciclo de 12s. El fundido ocupa el 4% del
	   ciclo (~0.5s) y las transiciones se cruzan: la que sale y la que entra
	   comparten esos 0.5s, asi que nunca hay un instante en blanco. */
	.diapositiva {
		opacity: 0;
		animation: rotar-captura 12s infinite;
	}

	.diapositiva:nth-child(2) {
		animation-delay: 4s;
	}

	.diapositiva:nth-child(3) {
		animation-delay: 8s;
	}

	@keyframes rotar-captura {
		0% {
			opacity: 0;
		}
		4% {
			opacity: 1;
		}
		33.3% {
			opacity: 1;
		}
		37.5% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}

	/* El punto sigue el mismo ciclo que la diapositiva que le toca. Se
	   distingue por forma, relleno contra contorno, y no por tono: en oscuro
	   `hairline` y `warm` son el mismo naranja y un cambio de color no se veria. */
	.punto {
		border: 1px solid var(--color-warm);
		animation: encender-punto 12s infinite;
	}

	.punto:nth-child(2) {
		animation-delay: 4s;
	}

	.punto:nth-child(3) {
		animation-delay: 8s;
	}

	@keyframes encender-punto {
		0%,
		37.5%,
		100% {
			background-color: transparent;
		}
		4%,
		33.3% {
			background-color: var(--color-warm);
		}
	}

	/* Un elemento que se mueve solo junto al titular es exactamente lo que esta
	   preferencia existe para detener. Sin animacion queda fija la primera
	   captura, que es la que mas vende. */
	@media (prefers-reduced-motion: reduce) {
		.diapositiva,
		.punto {
			animation: none;
		}

		.diapositiva:first-child {
			opacity: 1;
		}

		.punto:first-child {
			background-color: var(--color-warm);
		}
	}
</style>
