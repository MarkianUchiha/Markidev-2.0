---
import { site, socialLinks } from "../data/site";
import { getVisibleNavigation } from "../lib/content";

const availableNavigation = await getVisibleNavigation();

// Marcar la seccion activa necesita comparar contra la ruta actual. Se compara
// por prefijo para que /blog/un-articulo tambien resalte "Blog".
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const year = new Date().getFullYear();

// La superposicion NO vive dentro de la barra ni dentro de un <details>, y las
// dos cosas por la misma razon: cualquier ancestro con `backdrop-filter`,
// `transform` o `contain` se convierte en el bloque contenedor de sus hijos
// `position: fixed`, y la capa acaba midiendo lo que mide su padre en vez de la
// pantalla. Chrome implementa el contenido de <details> con
// `content-visibility: hidden`, que implica `contain`, asi que ahi tampoco cabe.
// Por eso el menu es hermano de la barra y se controla con un boton.
---

<header id="barra" class="border-hairline bg-canvas sticky top-0 z-50 border-b">
	<div
		class="mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-8 py-[18px]"
	>
		{/* El isotipo va inline y no como <img> a public/: son 364 bytes, asi que
		    un request de mas cuesta mas que el markup, y un <img> no puede seguir
		    al modo oscuro sin duplicar el archivo. Los tres colores salen de
		    tokens, de modo que la placa pasa de morada a naranja sola.

		    Dentro del sitio va el isotipo, nunca el lockup: el nombre ya esta
		    aqui al lado como texto, en Poppins 700 de verdad. */}
		<a href="/" class="flex items-center gap-2.5">
			<svg
				viewBox="0 0 200 200"
				class="h-8 w-8 shrink-0"
				aria-hidden="true"
				focusable="false"
			>
				<rect
					x="10"
					y="10"
					width="180"
					height="180"
					rx="40"
					class="fill-logo-placa"
				/>
				<path
					d="M80,58 L128,100 L80,142"
					fill="none"
					stroke-width="18"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="stroke-logo-trazo"
				/>
				<circle cx="152" cy="52" r="14" class="fill-logo-punto" />
			</svg>
			<span
				class="font-display text-ink-strong text-[18px] font-bold tracking-[-0.01em]"
			>
				{site.name}
			</span>
		</a>

		<button
			id="abrir-menu"
			type="button"
			aria-expanded="false"
			aria-controls="menu"
			class="bg-action text-on-action hover:bg-action-hover text-body-sm rounded-md cursor-pointer px-5 py-[11px] font-semibold tracking-[0.08em] uppercase transition-colors"
		>
			<span class="etiqueta-abrir">Menú</span>
			<span class="etiqueta-cerrar">Cerrar</span>
		</button>
	</div>
</header>

{/* Fondo morado a pantalla completa. El texto va en verde —5.83, pasa AA— y las
    divisiones en naranja. `hidden` lo oculta sin sacarlo del HTML, asi que los
    enlaces siguen ahi para quien lea el codigo fuente. */}
<div
	id="menu"
	hidden
	class="bg-action fixed inset-0 z-40 flex flex-col overflow-y-auto px-8 pt-28 pb-10"
>
	<nav aria-label="Principal" class="mx-auto w-full max-w-[1180px]">
		<ul class="flex flex-col">
			{
				availableNavigation.map((item) => (
					<li class="border-warm border-b">
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class:list={[
								"font-display hover:text-warm block py-4 text-[36px] leading-[1.1] font-titular tracking-[-0.02em] transition-colors sm:py-5 sm:text-[56px] lg:text-[72px]",
								isActive(item.href) ? "text-warm" : "text-on-action",
							]}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div
		class="mx-auto mt-10 flex w-full max-w-[1180px] flex-1 flex-col justify-end gap-8 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			{/* Al pasar a naranja el texto tiene que dejar de ser morado: ese par da
			    3.50 y esto es texto de 15px, que necesita 4.5. Con negro mate son
			    8.75. En reposo no hay problema: verde de fondo con morado encima son
			    5.83. */}
			<a
				href={site.whatsapp.url}
				target="_blank"
				rel="noopener noreferrer"
				class="bg-on-action text-action hover:bg-warm hover:text-on-warm text-body rounded-md inline-block px-7 py-4 font-semibold transition-colors"
			>
				Quiero conocerte
			</a>
			<p class="text-body-sm text-on-action mt-4 opacity-80">
				Te respondo yo mismo por WhatsApp.
			</p>
		</div>

		{/* El cambio de tema vive aqui dentro y no en la barra: la barra son dos
		    piezas —el nombre y MENU— y meterle una tercera le quita el filo.

		    Viste como los iconos de redes, no como los tokens de pagina, porque el
		    menu es morado en los dos modos: si usara `--color-ink` se volveria
		    invisible al alternar. Por eso tampoco cambia de aspecto al pulsarlo,
		    solo de etiqueta.

		    Al llenarse de naranja su texto pasa a negro mate (`on-warm`, 8.75) y no
		    a morado como en los iconos de al lado: ahi el par morado/naranja viste
		    un grafico, que se conforma con 3:1, pero aqui hay texto de 14px y ese
		    par da 3.50. */}
		<div class="flex flex-wrap items-center gap-4">
			<button
				id="cambiar-tema"
				type="button"
				class="border-warm text-on-action hover:bg-warm hover:text-on-warm text-body-sm flex h-11 cursor-pointer items-center gap-2 rounded-full border px-5 font-semibold transition-colors"
			>
				<span class="etiqueta-a-claro flex items-center gap-2">
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						class="size-5"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="4.5"></circle>
						<path
							d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4"
						></path>
					</svg>
					Ver en claro
				</span>
				<span class="etiqueta-a-oscuro flex items-center gap-2">
					<svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
					</svg>
					Ver en oscuro
				</span>
			</button>

			<ul class="flex items-center gap-4">
				{
					socialLinks.map((red) => (
						<li>
							<a
								href={red.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={red.name}
								class="border-warm text-on-action hover:bg-warm hover:text-action flex size-11 items-center justify-center rounded-full border transition-colors"
							>
								<svg
									viewBox="0 0 24 24"
									fill="currentColor"
									class="size-5"
									aria-hidden="true"
								>
									<path d={red.icon} />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<p
		class="text-on-action mx-auto mt-10 w-full max-w-[1180px] text-[12px] opacity-60"
	>
		© {year} {site.author} · México
	</p>
</div>

<style>
	/* La palabra del boton sigue al estado, sin tocarla desde el script. */
	#abrir-menu[aria-expanded="false"] .etiqueta-cerrar,
	#abrir-menu[aria-expanded="true"] .etiqueta-abrir {
		display: none;
	}
</style>

<style is:global>
	/* Con el menu abierto la barra pierde su fondo: el morado pasa por debajo y el
	   conjunto se lee como una sola pieza. El boton queda por encima de la capa. */
	body:has(#abrir-menu[aria-expanded="true"]) #barra {
		background-color: transparent;
		border-color: transparent;
		z-index: 60;
	}

	body:has(#abrir-menu[aria-expanded="true"]) #barra .font-display,
	body:has(#abrir-menu[aria-expanded="true"]) #barra span {
		color: var(--color-on-action);
	}

	/* Sin esto la pagina de atras sigue desplazandose bajo el menu abierto. */
	body:has(#abrir-menu[aria-expanded="true"]) {
		overflow: hidden;
	}

	/* Mismo truco que el boton Menu/Cerrar, pero mirando al <html>: la etiqueta
	   ofrece el modo CONTRARIO al que se esta viendo, y la decide el CSS. Si la
	   escribiera el script, quien llega en claro veria un instante la etiqueta
	   equivocada mientras el JavaScript del menu baja.

	   Va aqui y no en el <style> de arriba porque Astro le pega el atributo de
	   scope a los selectores del componente, y <html> no es parte de el. */
	html:not([data-tema="claro"]) .etiqueta-a-oscuro,
	html[data-tema="claro"] .etiqueta-a-claro {
		display: none;
	}
</style>

<script is:inline>
	(() => {
		const boton = document.getElementById("abrir-menu");
		const menu = document.getElementById("menu");
		if (!boton || !menu) return;

		const abierto = () => boton.getAttribute("aria-expanded") === "true";

		function alternar(quiereAbrir) {
			boton.setAttribute("aria-expanded", String(quiereAbrir));
			menu.hidden = !quiereAbrir;
			// Al abrir, el foco entra al menu; al cerrar, vuelve al boton. Sin esto
			// quien navega con teclado se queda en la pagina de atras, que ya no ve.
			if (quiereAbrir) menu.querySelector("a")?.focus();
			else boton.focus();
		}

		boton.addEventListener("click", () => alternar(!abierto()));

		// El tema se guarda con los dos valores escritos, aunque "oscuro" y "no
		// hay nada" pinten igual hoy: la diferencia entre "nunca elegi" y "elegi
		// oscuro" es la que permitiria volver a seguir al sistema mas adelante.
		document.getElementById("cambiar-tema")?.addEventListener("click", () => {
			const raiz = document.documentElement;
			const quiereClaro = raiz.dataset.tema !== "claro";

			if (quiereClaro) raiz.dataset.tema = "claro";
			else delete raiz.dataset.tema;

			try {
				localStorage.setItem("tema", quiereClaro ? "claro" : "oscuro");
			} catch {
				// Sin almacenamiento el cambio vale para esta pagina y ya. Preferible
				// a que el boton no haga nada.
			}
		});

		document.addEventListener("keydown", (evento) => {
			if (evento.key === "Escape" && abierto()) alternar(false);
		});
	})();
</script>
