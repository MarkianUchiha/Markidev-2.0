---
import { site, socialLinks } from "../data/site";
import { getVisibleNavigation } from "../lib/content";

const availableNavigation = await getVisibleNavigation();

// Marcar la seccion activa necesita comparar contra la ruta actual. Se compara
// por prefijo para que /blog/un-articulo tambien resalte "Blog".
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const year = new Date().getFullYear();

// La superposicion NO vive dentro de la barra ni dentro de un <details>, y las
// dos cosas por la misma razon: cualquier ancestro con `backdrop-filter`,
// `transform` o `contain` se convierte en el bloque contenedor de sus hijos
// `position: fixed`, y la capa acaba midiendo lo que mide su padre en vez de la
// pantalla. Chrome implementa el contenido de <details> con
// `content-visibility: hidden`, que implica `contain`, asi que ahi tampoco cabe.
// Por eso el menu es hermano de la barra y se controla con un boton.
---

<header id="barra" class="border-hairline bg-canvas sticky top-0 z-50 border-b">
	<div
		class="mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-8 py-[18px]"
	>
		{/* El isotipo va inline y no como <img> a public/: son 364 bytes, asi que
		    un request de mas cuesta mas que el markup, y un <img> no puede seguir
		    al modo oscuro sin duplicar el archivo. Los tres colores salen de
		    tokens, de modo que la placa pasa de morada a naranja sola.

		    Dentro del sitio va el isotipo, nunca el lockup: el nombre ya esta
		    aqui al lado como texto, en Poppins 700 de verdad. */}
		<a href="/" class="flex items-center gap-2.5">
			<svg
				viewBox="0 0 200 200"
				class="h-8 w-8 shrink-0"
				aria-hidden="true"
				focusable="false"
			>
				<rect
					x="10"
					y="10"
					width="180"
					height="180"
					rx="40"
					class="fill-logo-placa"
				/>
				<path
					d="M80,58 L128,100 L80,142"
					fill="none"
					stroke-width="18"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="stroke-logo-trazo"
				/>
				<circle cx="152" cy="52" r="14" class="fill-logo-punto" />
			</svg>
			<span
				class="font-display text-ink-strong text-[18px] font-bold tracking-[-0.01em]"
			>
				{site.name}
			</span>
		</a>

		<button
			id="abrir-menu"
			type="button"
			aria-expanded="false"
			aria-controls="menu"
			class="bg-action text-on-action hover:bg-action-hover text-body-sm rounded-md cursor-pointer px-5 py-[11px] font-semibold tracking-[0.08em] uppercase transition-colors"
		>
			<span class="etiqueta-abrir">Menú</span>
			<span class="etiqueta-cerrar">Cerrar</span>
		</button>
	</div>
</header>

{/* Fondo morado a pantalla completa. El texto va en verde —5.83, pasa AA— y las
    divisiones en naranja. `hidden` lo oculta sin sacarlo del HTML, asi que los
    enlaces siguen ahi para quien lea el codigo fuente. */}
<div
	id="menu"
	hidden
	class="bg-action fixed inset-0 z-40 flex flex-col overflow-y-auto px-8 pt-28 pb-10"
>
	<nav aria-label="Principal" class="mx-auto w-full max-w-[1180px]">
		<ul class="flex flex-col">
			{
				availableNavigation.map((item) => (
					<li class="border-warm border-b">
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class:list={[
								"font-display hover:text-warm block py-4 text-[36px] leading-[1.1] font-bold tracking-[-0.02em] transition-colors sm:py-5 sm:text-[56px] lg:text-[72px]",
								isActive(item.href) ? "text-warm" : "text-on-action",
							]}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div
		class="mx-auto mt-10 flex w-full max-w-[1180px] flex-1 flex-col justify-end gap-8 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			<a
				href={site.whatsapp.url}
				target="_blank"
				rel="noopener noreferrer"
				class="bg-on-action text-action hover:bg-warm text-body rounded-md inline-block px-7 py-4 font-semibold transition-colors"
			>
				Quiero conocerte
			</a>
			<p class="text-body-sm text-on-action mt-4 opacity-80">
				Te respondo yo mismo por WhatsApp.
			</p>
		</div>

		<ul class="flex items-center gap-4">
			{
				socialLinks.map((red) => (
					<li>
						<a
							href={red.url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={red.name}
							class="border-warm text-on-action hover:bg-warm hover:text-action flex size-11 items-center justify-center rounded-full border transition-colors"
						>
							<svg
								viewBox="0 0 24 24"
								fill="currentColor"
								class="size-5"
								aria-hidden="true"
							>
								<path d={red.icon} />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<p
		class="text-on-action mx-auto mt-10 w-full max-w-[1180px] text-[12px] opacity-60"
	>
		© {year} {site.author} · México
	</p>
</div>

<style>
	/* La palabra del boton sigue al estado, sin tocarla desde el script. */
	#abrir-menu[aria-expanded="false"] .etiqueta-cerrar,
	#abrir-menu[aria-expanded="true"] .etiqueta-abrir {
		display: none;
	}
</style>

<style is:global>
	/* Con el menu abierto la barra pierde su fondo: el morado pasa por debajo y el
	   conjunto se lee como una sola pieza. El boton queda por encima de la capa. */
	body:has(#abrir-menu[aria-expanded="true"]) #barra {
		background-color: transparent;
		border-color: transparent;
		z-index: 60;
	}

	body:has(#abrir-menu[aria-expanded="true"]) #barra .font-display,
	body:has(#abrir-menu[aria-expanded="true"]) #barra span {
		color: var(--color-on-action);
	}

	/* Sin esto la pagina de atras sigue desplazandose bajo el menu abierto. */
	body:has(#abrir-menu[aria-expanded="true"]) {
		overflow: hidden;
	}
</style>

<script is:inline>
	(() => {
		const boton = document.getElementById("abrir-menu");
		const menu = document.getElementById("menu");
		if (!boton || !menu) return;

		const abierto = () => boton.getAttribute("aria-expanded") === "true";

		function alternar(quiereAbrir) {
			boton.setAttribute("aria-expanded", String(quiereAbrir));
			menu.hidden = !quiereAbrir;
			// Al abrir, el foco entra al menu; al cerrar, vuelve al boton. Sin esto
			// quien navega con teclado se queda en la pagina de atras, que ya no ve.
			if (quiereAbrir) menu.querySelector("a")?.focus();
			else boton.focus();
		}

		boton.addEventListener("click", () => alternar(!abierto()));

		document.addEventListener("keydown", (evento) => {
			if (evento.key === "Escape" && abierto()) alternar(false);
		});
	})();
</script>
