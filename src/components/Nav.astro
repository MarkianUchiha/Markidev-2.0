---
import { site } from "../data/site";
import { getVisibleNavigation } from "../lib/content";

const availableNavigation = await getVisibleNavigation();

// Marcar la seccion activa necesita comparar contra la ruta actual. Se compara
// por prefijo para que /blog/un-articulo tambien resalte "Blog".
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
	class="border-hairline bg-canvas/90 sticky top-0 z-20 border-b backdrop-blur-md"
>
	<div
		class="mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-8 py-[18px]"
	>
		{/* Marca provisional del mockup: un cuadro con un acento dentro. No es el
		    logo definitivo, y por eso no vive como archivo en public/. */}
		<a href="/" class="flex items-center gap-2.5">
			<span
				class="bg-ink flex h-[30px] w-[30px] items-center justify-center rounded-md"
				aria-hidden="true"
			>
				<span class="bg-accent-on-dark block h-3 w-3"></span>
			</span>
			<span
				class="font-display text-ink-strong text-[18px] font-bold tracking-[-0.01em]"
			>
				{site.name}
			</span>
		</a>

		{
			availableNavigation.length > 0 && (
				<nav aria-label="Principal">
					<ul class="flex gap-8">
						{availableNavigation.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={isActive(item.href) ? "page" : undefined}
									class:list={[
										"hover:text-accent-text text-body font-medium transition-colors",
										isActive(item.href) ? "text-accent-text" : "text-ink",
									]}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}

		{/* El mockup decia "Agenda una llamada", pero no hay herramienta de agenda
		    todavia: prometerla y que no exista es peor que no ofrecerla. */}
		<a
			href="/#contacto"
			class="bg-btn-dark text-canvas hover:bg-btn-dark-hover text-body-sm rounded-md px-5 py-[11px] font-semibold whitespace-nowrap transition-colors"
		>
			Hablemos
		</a>
	</div>
</header>
