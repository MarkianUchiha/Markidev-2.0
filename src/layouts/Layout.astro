---
import "../styles/global.css";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Pie from "../components/Pie.astro";

interface Props {
	titulo: string;
	descripcion: string;
}

const { titulo, descripcion } = Astro.props;

// Sin esto las URL canonicas salen relativas y los rastreadores las descartan.
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonica} />
		<meta property="og:locale" content="es_MX" />

		{/* Se precarga solo la cara con la que abre la pagina: el titular en Space
		    Grotesk y el cuerpo en IBM Plex regular. Las demas caras bajan cuando
		    aparecen, y las cursivas solo si un articulo las usa. */}
		<Font cssVariable="--font-space-grotesk" preload={[{ weight: 700 }]} />
		<Font cssVariable="--font-ibm-plex-sans" preload={[{ weight: 400, style: "normal" }]} />
	</head>
	<body class="bg-canvas text-ink font-body flex min-h-screen flex-col text-pretty antialiased">
		{/* El salto al contenido es lo primero que encuentra quien navega con
		    teclado; sin el hay que recorrer toda la navegacion en cada pagina. */}
		<a
			href="#contenido"
			class="bg-canvas text-ink focus:ring-accent sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:m-4 focus:rounded-md focus:px-6 focus:py-3 focus:ring-2"
		>
			Saltar al contenido
		</a>

		<Nav />

		{/* flex-1 empuja el pie al fondo cuando la pagina tiene poco contenido. */}
		<main id="contenido" class="flex-1">
			<slot />
		</main>

		<Pie />
	</body>
</html>
