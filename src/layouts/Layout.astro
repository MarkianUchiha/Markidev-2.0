---
import "../styles/global.css";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Pie from "../components/Pie.astro";

interface Props {
	titulo: string;
	descripcion: string;
}

const { titulo, descripcion } = Astro.props;

// Sin esto las URL canonicas salen relativas y los rastreadores las descartan.
const canonica = new URL(Astro.url.pathname, Astro.site);

// Misma razon que la canonica, y aqui pesa mas: el canal principal es WhatsApp
// y con una ruta relativa el enlace se comparte sin imagen. Una sola previa
// para todo el sitio; las paginas no la cambian.
const previa = new URL("/og-markidev.png", Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonica} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:image" content={previa} />
		{/* Declarar el tamano evita que WhatsApp y Facebook enseñen un hueco
		    mientras bajan la imagen para medirla. */}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="MarkiDev" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={previa} />

		{/* El SVG cambia de color con el modo del navegador; el PNG queda de
		    respaldo para quien no lo lea. El de iOS va aparte porque Apple no
		    acepta SVG y pinta de negro lo que sea transparente: ese va a sangre. */}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		{/* Se precarga solo la cara con la que abre la pagina: el titular en Space
		    Grotesk y el cuerpo en IBM Plex regular. Las demas caras bajan cuando
		    aparecen, y las cursivas solo si un articulo las usa. */}
		<Font cssVariable="--font-poppins" preload={[{ weight: 700 }]} />
		<Font cssVariable="--font-open-sans" preload={[{ weight: 400, style: "normal" }]} />
		{/* La serif no se precarga: aparece solo en citas, y a veces en ninguna. */}
		<Font cssVariable="--font-crimson-pro" />
	</head>
	<body class="bg-canvas text-ink font-body flex min-h-screen flex-col text-pretty antialiased">
		{/* El salto al contenido es lo primero que encuentra quien navega con
		    teclado; sin el hay que recorrer toda la navegacion en cada pagina. */}
		<a
			href="#contenido"
			class="bg-canvas text-ink focus:ring-brand-solid sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:m-4 focus:rounded-md focus:px-6 focus:py-3 focus:ring-2"
		>
			Saltar al contenido
		</a>

		<Nav />

		{/* flex-1 empuja el pie al fondo cuando la pagina tiene poco contenido. */}
		<main id="contenido" class="flex-1">
			<slot />
		</main>

		<Pie />
	</body>
</html>
