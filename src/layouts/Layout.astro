---
import '../styles/global.css';

interface Props {
	titulo: string;
	descripcion: string;
}

const { titulo, descripcion } = Astro.props;

// Sin esto las URL canonicas salen relativas y los rastreadores las descartan.
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonica} />
		<meta property="og:locale" content="es_MX" />
	</head>
	<body class="bg-canvas text-ink font-primary antialiased">
		<slot />
	</body>
</html>
